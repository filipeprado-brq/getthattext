{
  "name": "getthattext",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "copy:assets": "cp src/renderer/index.html src/renderer/pcm-worklet.js dist/renderer/",
    "start": "npm run build && electron dist/main/main.js",
    "verify:speech-gate": "node scripts/verify-speech-gate.mjs",
    "verify:rewrite": "node scripts/verify-rewrite.mjs",
    "key:import": "electron scripts/import-groq-key.js",
    "build:icons": "electron scripts/build-tray-icons.js",
    "verify:blip": "electron scripts/verify-blip.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Ditado para macOS: fala vira texto no clipboard",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^41.7.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0"
  }
}
