{
  "name": "getthattext",
  "version": "0.1.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "build": "npm run build:main && npm run build:renderer && npm run copy:assets",
    "copy:assets": "cp src/renderer/*.html src/renderer/*.css src/renderer/pcm-worklet.js dist/renderer/",
    "start": "npm run build && electron dist/main/main.js",
    "verify:speech-gate": "node scripts/verify-speech-gate.mjs",
    "verify:rewrite": "node scripts/verify-rewrite.mjs",
    "key:import": "electron scripts/import-groq-key.js",
    "build:icons": "electron scripts/build-tray-icons.js",
    "verify:blip": "electron scripts/verify-blip.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Ditado para macOS: fala vira texto no clipboard",
  "private": true,
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^41.7.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "groq-sdk": "^1.6.0"
  },
  "productName": "getthattext",
  "build": {
    "appId": "com.filipeprado.getthattext",
    "productName": "getthattext",
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O getthattext usa o microfone para transcrever o que voc\u00ea dita. O \u00e1udio \u00e9 processado na sua m\u00e1quina e n\u00e3o \u00e9 enviado a lugar nenhum.",
        "LSUIElement": true
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
